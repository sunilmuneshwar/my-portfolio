# GEMINI_API_KEY: Optional AI Studio runtime variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase client configuration for Contact Form ('contacts' table)
# Configure in Settings -> Secrets (do not commit real keys):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-side contact email delivery (Resend API)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional server-side webhook URL
CONTACT_WEBHOOK_URL=
